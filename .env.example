PORT=4181
DATABASE_URL=postgres://acquisition_os_user:change_me@127.0.0.1:5432/acquisition_os

# Local demo mode — runs the app with in-memory data instead of Postgres.
# - Vercel + MEMORY_DB=1 is blocked by a fail-fast guard (read-only FS).
# - In MEMORY_DB=1, auth checks are bypassed for local dev.
MEMORY_DB=0

# Clerk auth (required in production and on Vercel).
# Get keys from https://dashboard.clerk.com → API Keys.
# Use sk_test_/pk_test_ keys for development and sk_live_/pk_live_ for prod.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# UploadThing token for durable photo/video uploads.
# Get this from https://uploadthing.com/dashboard in the API Keys tab.
# Required on Vercel if users need file uploads.
# UPLOADTHING_TOKEN=uploadthing_token_here

# Local dev only: when UPLOADTHING_TOKEN is unset and not on Vercel, the
# server normally writes to ./uploads/media on disk. Set this to "data-url"
# to fall back to inline base64 URLs instead (useful when /uploads is not
# served by your dev setup).
# UPLOADTHING_LOCAL_FALLBACK=data-url

# RentCast property data API key for AVM, comps, listings, market data.
RENTCAST_API_KEY=

# Seed safety: required (with NODE_ENV=production) to run scripts/seed.js
# against production data. Without it, seed refuses to run in production.
SEED_ALLOW_OVERWRITE=0
